# =============================================================
# Lavender Trinetra — AI Cybersecurity & System Health Monitor
# Environment Configuration
# =============================================================
# Copy this file to `.env` in the backend root and adjust values
# per environment (development / staging / production).
# Never commit real secrets — this file should stay in .gitignore.
# =============================================================

# ---------------------------
# Application Identity
# ---------------------------
APP_NAME=Lavender Trinetra
APP_VERSION=1.0.0
DEBUG=False

# ---------------------------
# Server / API
# ---------------------------
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------
# Security
# ---------------------------
# Used for signing tokens / sessions — replace with a long random
# value in production (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-this-to-a-secure-random-secret-key

# ---------------------------
# Database (SQLite)
# ---------------------------
DATABASE_URL=sqlite:///./backend/data/system_monitor.db

# ---------------------------
# Logging
# ---------------------------
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FILE_PATH=./backend/data/system_health.log

# ---------------------------
# Monitoring Engine
# ---------------------------
# Interval (in seconds) between each monitoring cycle
MONITORING_INTERVAL=5

# Alert thresholds (percentage, 0-100)
CPU_THRESHOLD=85
RAM_THRESHOLD=85
DISK_THRESHOLD=90

# Network threshold (in MB/s)
NETWORK_THRESHOLD=100

# ---------------------------
# AI Engine
# ---------------------------
AI_MODEL_PATH=./backend/ai/models/isolation_forest.joblib
AI_SCALER_PATH=./backend/ai/models/scaler.joblib

# ---------------------------
# Storage Paths
# ---------------------------
CSV_STORAGE_PATH=./backend/data
REPORT_STORAGE_PATH=./backend/data/reports

# =====================================================================
# Lavender Trinetra — Frontend Environment Configuration
# Development defaults. Override per-environment (e.g. .env.production,
# .env.staging) or via deployment platform environment variables.
# =====================================================================

# App identity
VITE_APP_NAME=Lavender Trinetra
VITE_APP_VERSION=1.0.0

# Backend connectivity
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws

# Environment
VITE_ENVIRONMENT=development

# Feature flags
VITE_ENABLE_AI=true
VITE_ENABLE_MONITORING=true
VITE_ENABLE_CYBERSECURITY=true